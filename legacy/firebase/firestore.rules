rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() { return request.auth != null && request.auth.token.admin == true && request.auth.token.email_verified == true && get(/databases/$(database)/documents/adminEmails/$(request.auth.token.email.lower())).data.enabled == true; }
  match /campaigns/{id} { allow read: if admin() || resource.data.status == 'published'; }
  match /publicSlots/{id} { allow read: if admin() || get(/databases/$(database)/documents/campaigns/$(resource.data.campaignId)).data.status == 'published'; }
  match /settings/booking { allow read: if true; }
  match /{document=**} { allow read: if admin(); allow write: if false; }
 }
}
